server {
  listen 443 ssl;
  
  ssl_certificate /etc/nginx/ssl/my.domain.com.crt;
  ssl_certificate_key /etc/nginx/ssl/my.domain.com.key;
  
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;

  location /zt/dev/obac-fifa {
    proxy_pass http://obac-fifa:3000/zt/dev/obac-fifa;
  }

  location /zt/dev/obac-idaas {
    proxy_pass http://obac-idaas:3000/zt/dev/obac-idaas;
  }

  location /zt/dev/obac-idaas-server {
    proxy_pass http://obac-idaas-server:8080;
    rewrite ^/zt/dev/obac-idaas-server(.*)$ $1 break;
    proxy_redirect http://obac-idaas-server:8080/ $scheme://$http_host/;
  }
}
